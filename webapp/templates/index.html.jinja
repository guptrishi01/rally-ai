<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>RallyAI</title>
  <style>
    body { font-family: sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
    label { display: block; margin-top: 0.75rem; }
    input, select, textarea { width: 100%; box-sizing: border-box; padding: 0.35rem; }
    .error { color: #b3261e; }
    .row { display: flex; gap: 1rem; }
    .row > div { flex: 1; }
    button { margin-top: 1.5rem; padding: 0.6rem 1.2rem; }

    .tabs { display: flex; gap: 0.5rem; border-bottom: 2px solid #ddd; margin-bottom: 1.5rem; }
    .tab-button {
      margin-top: 0; padding: 0.6rem 1.2rem; border: none; background: none;
      font-size: 1rem; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px;
    }
    .tab-button.active { border-bottom-color: #2a78d6; font-weight: bold; }
    .panel { display: none; }
    .panel.active { display: block; }

    #import-status { margin-top: 1rem; }
    #import-status h2 { margin-bottom: 0.25rem; }
    .flags { font-weight: bold; }

    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #eee; }
    .result-w { color: #0ca30c; font-weight: bold; }
    .result-l { color: #d03b3b; font-weight: bold; }
    .empty-state { color: #666; }
  </style>
</head>
<body>
  <div class="tabs">
    <button type="button" class="tab-button active" id="tab-input">Input</button>
    <button type="button" class="tab-button" id="tab-results">Results</button>
  </div>

  <div class="panel active" id="panel-input">
    <h1>Import a SwingVision match</h1>
    <form id="import-form" enctype="multipart/form-data">
      <label>SwingVision export (.xlsx)
        <input type="file" name="xlsx_file" accept=".xlsx" required>
      </label>
      <label>Match video (optional, multiple files allowed for a split recording)
        <input type="file" name="video_files" multiple>
      </label>

      <div class="row">
        <div>
          <label>Date
            <input type="date" name="date" required>
          </label>
        </div>
        <div>
          <label>Opponent
            <input type="text" name="opponent" required>
          </label>
        </div>
        <div>
          <label>Result
            <select name="result" required>
              <option value="W">Win</option>
              <option value="L">Loss</option>
            </select>
          </label>
        </div>
      </div>

      <label>Confirm your name as tracked by SwingVision (optional)
        <input type="text" name="tracked_identity" placeholder="e.g. Rishi Gupta">
      </label>

      <div class="row">
        {% for n in (1, 2, 3) %}
        <div>
          <label>Who served first in Set {{ n }}? (optional)
            <select name="first_server_set{{ n }}">
              <option value="">Not sure / N/A</option>
              <option value="me">Me</option>
              <option value="opponent">Opponent</option>
            </select>
          </label>
        </div>
        {% endfor %}
      </div>

      <div class="row">
        <div>
          <label>Energy rating (1-5)
            <input type="number" name="energy_rating" min="1" max="5">
          </label>
        </div>
        <div>
          <label>Mental rating (1-5)
            <input type="number" name="mental_rating" min="1" max="5">
          </label>
        </div>
        <div>
          <label>Location
            <input type="text" name="location">
          </label>
        </div>
      </div>

      <label>Pros
        <textarea name="pros" rows="2"></textarea>
      </label>
      <label>Cons
        <textarea name="cons" rows="2"></textarea>
      </label>
      <label>Notes
        <textarea name="notes" rows="2"></textarea>
      </label>

      <button type="submit">Import</button>
    </form>

    <div id="import-status"></div>
  </div>

  <div class="panel" id="panel-results">
    <h1>Results</h1>
    {% if matches %}
      <iframe id="history-frame" srcdoc="{{ history_html }}"
              style="width:100%; height:900px; border:none;"></iframe>

      <h2>Matches</h2>
      <table>
        <thead>
          <tr><th>Date</th><th>Opponent</th><th>Result</th><th>FS%</th><th>Points Won%</th><th></th></tr>
        </thead>
        <tbody>
          {% for m in matches %}
          <tr>
            <td>{{ m.date }}</td>
            <td>{{ m.opponent }}</td>
            <td class="{{ 'result-w' if m.result == 'W' else 'result-l' }}">{{ m.result }}</td>
            <td>{{ m.serving.first_serve_pct }}%</td>
            <td>{{ m.point_outcomes.points_won_pct }}%</td>
            <td><a href="/report/{{ m.match_id }}">View report</a></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="empty-state">
        No matches finalized yet. A submitted match appears here once it's been reviewed
        and finalized (see the CLI: <code>scripts/resolve_reviews.py</code> /
        <code>scripts/import_match.py</code>'s <code>pipeline.finalize()</code>).
      </p>
    {% endif %}
  </div>

  <script>
    function showTab(name) {
      document.getElementById('tab-input').classList.toggle('active', name === 'input');
      document.getElementById('tab-results').classList.toggle('active', name === 'results');
      document.getElementById('panel-input').classList.toggle('active', name === 'input');
      document.getElementById('panel-results').classList.toggle('active', name === 'results');
    }
    document.getElementById('tab-input').addEventListener('click', () => showTab('input'));
    document.getElementById('tab-results').addEventListener('click', () => showTab('results'));

    async function postForm(url, formData) {
      const response = await fetch(url, { method: 'POST', body: formData });
      const html = await response.text();
      document.getElementById('import-status').innerHTML = html;
    }

    document.getElementById('import-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      await postForm('/import', new FormData(event.target));
    });

    // Event delegation: the suggest form is injected dynamically into
    // #import-status by the fetch above, so a direct listener bound at
    // page-load time would never see it - listen on the stable parent
    // instead and check which form actually submitted.
    document.getElementById('import-status').addEventListener('submit', async (event) => {
      if (event.target.id === 'suggest-form') {
        event.preventDefault();
        await postForm('/suggest', new FormData(event.target));
      }
    });
  </script>
</body>
</html>
