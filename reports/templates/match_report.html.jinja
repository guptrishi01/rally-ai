<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>RallyAI — {{ match.opponent }} — {{ match.date }}</title>
<style>
  {{ palette_css }}
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--page);
    color: var(--ink-primary);
  }
  .report { max-width: 720px; margin: 0 auto; padding: 24px 16px 64px; }
  header.match-header { margin-bottom: 24px; }
  header.match-header h1 { font-size: 22px; margin: 0 0 4px; }
  header.match-header .meta { color: var(--ink-secondary); font-size: 14px; }
  .kpi-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .kpi-row > div { flex: 1 1 140px; border: 1px solid var(--gridline); border-radius: 8px; }
  section { margin-bottom: 32px; }
  section h2 { font-size: 16px; border-bottom: 1px solid var(--gridline); padding-bottom: 8px; }
  .coaching-card {
    border: 1px solid var(--gridline);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 12px;
  }
  .coaching-card .priority {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .coaching-card .recommendation { font-weight: 600; margin: 4px 0; }
  .coaching-card .observation { color: var(--ink-secondary); font-size: 14px; }
  .coaching-card .drill-meta,
  .coaching-card .focus-area {
    font-size: 13px;
    color: var(--ink-secondary);
    margin-top: 6px;
  }
  .self-assessment p { font-size: 14px; }
</style>
</head>
<body>
<div class="viz-root report">
  <header class="match-header">
    <h1>{{ match.opponent }} — {{ match.result }}</h1>
    <div class="meta">
      {{ match.date }}
      {%- if energy_rating %} · Energy {{ energy_rating }}/5{% endif -%}
      {%- if mental_rating %} · Mental {{ mental_rating }}/5{% endif %}
    </div>
  </header>

  <section class="kpi-row">
    {% for tile in stat_tiles %}<div>{{ tile | safe }}</div>{% endfor %}
  </section>

  <section>
    <h2>Point Outcome Breakdown</h2>
    {{ point_outcome_chart | safe }}
  </section>

  <section>
    <h2>First / Second Serve In vs. Out</h2>
    {{ serve_chart | safe }}
  </section>

  {% if net_meter %}
  <section>
    <h2>Net Play</h2>
    {{ net_meter | safe }}
  </section>
  {% endif %}

  {% if improvement_plan %}
  <section>
    <h2>Improvement Plan</h2>
    {% for item in improvement_plan %}
    <div class="coaching-card">
      <div class="priority">{{ item.priority }} priority · {{ item.category }}</div>
      <div class="recommendation">{{ item.recommendation }}</div>
      <div class="observation">{{ item.observation }}</div>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Strategy</h2>
    {% for item in strategy %}
    <div class="coaching-card">
      <div class="priority">{{ item.priority }} priority</div>
      <div class="recommendation">{{ item.recommendation }}</div>
      <div class="observation">{{ item.observation }}</div>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Drills</h2>
    {% for item in drills %}
    <div class="coaching-card">
      <div class="priority">{{ item.priority }} priority</div>
      <div class="recommendation">{{ item.recommendation }}</div>
      <div class="observation">{{ item.observation }}</div>
      <div class="drill-meta">{{ item.drill_name }} — {{ item.frequency }}</div>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Fitness</h2>
    {% for item in fitness %}
    <div class="coaching-card">
      <div class="priority">{{ item.priority }} priority</div>
      <div class="recommendation">{{ item.recommendation }}</div>
      <div class="observation">{{ item.observation }}</div>
      <div class="focus-area">Focus: {{ item.focus_area }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if pros or cons %}
  <section class="self-assessment">
    <h2>Self-Assessment</h2>
    {% if pros %}<p><strong>Pros:</strong> {{ pros }}</p>{% endif %}
    {% if cons %}<p><strong>Cons:</strong> {{ cons }}</p>{% endif %}
  </section>
  {% endif %}
</div>
</body>
</html>
